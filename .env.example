# Cloudflare Tunnel Token
# 從 Cloudflare Zero Trust Dashboard 取得
# Zero Trust > Networks > Tunnels > 你的 Tunnel > Configure > Install and run connector
CF_TUNNEL_TOKEN=your_tunnel_token_here

# OpenRouter AI 分析設定
# API Key：https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# 使用的模型（預設 z-ai/glm-5.3-flash，成本約為 gemini-3.1-flash-lite 的 1/4.6）
OPENROUTER_MODEL=z-ai/glm-5.3-flash

# GLM 系列預設開啟 thinking 且無法停用，以 minimal 壓到 0 reasoning token；
# 留空則不送此參數（換用 gemini 等模型時請留空）
OPENROUTER_REASONING_EFFORT=minimal

# 優先使用的 provider（依序遞補）。實測僅部分 provider 真的遵守 reasoning effort，
# Novita、GMICloud 可壓到 0；留空則交由 OpenRouter 自動路由
OPENROUTER_PROVIDERS=Novita,GMICloud

# 上述 provider 都不可用時是否改用其他家。
# true：可能退回會 thinking 的 provider（較慢較貴），但拿得到結果
# false：只用指定的 provider，都不可用就整批失敗（下次會重跑）
OPENROUTER_ALLOW_FALLBACKS=true

# 每批分析的貼文數
ANALYZE_BATCH_SIZE=10
